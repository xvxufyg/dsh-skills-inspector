{
  "name": "@local/skills-inspector",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "dsh": ">=0.2.1-rc.5 <1.0.0"
  },
  "keywords": ["deepseek-harness", "cordis-plugin", "skills", "chinese", "productivity"],
  "description": "Browse every installed skill and the assembled system prompt from a dock below the composer.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
